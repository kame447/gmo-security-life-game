#!/bin/bash
set -euxo pipefail

mkdir -p /var/log/app /srv/app/api

# 仮置きのヘルスチェック用サーバ（エージェントの導入に失敗しても先に動かしておく）
echo ok > /srv/app/api/health
(cd /srv/app && nohup python3 -m http.server 80 >>/var/log/app/placeholder.log 2>&1 &)

# CloudWatch エージェント（パッケージは S3 ゲートウェイエンドポイント経由で取得する）
dnf install -y amazon-cloudwatch-agent
cat > /opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json <<'JSON'
{
  "logs": {
    "logs_collected": {
      "files": {
        "collect_list": [
          {
            "file_path": "/var/log/app/*.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/app"
          },
          {
            "file_path": "/var/log/cloud-init-output.log",
            "log_group_name": "${log_group}",
            "log_stream_name": "{instance_id}/cloud-init"
          }
        ]
      }
    }
  }
}
JSON
/opt/aws/amazon-cloudwatch-agent/bin/amazon-cloudwatch-agent-ctl \
  -a fetch-config -m ec2 -s \
  -c file:/opt/aws/amazon-cloudwatch-agent/etc/amazon-cloudwatch-agent.json
